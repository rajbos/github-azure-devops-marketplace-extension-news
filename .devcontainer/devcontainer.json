// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "marketplace-extension-news",
	// Same image the CI build runs in (.github/workflows/ci-build.yml). It ships a .NET SDK + .NET 8 runtime,
	// PowerShell, and the Playwright browsers + OS dependencies matching the Microsoft.Playwright
	// version in Directory.Packages.props. Bump this tag together with that package version.
	"image": "mcr.microsoft.com/playwright/dotnet:v1.61.0-noble",

	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	"containerEnv": {
		// No display in the container: always launch Playwright headless.
		"PLAYWRIGHT_HEADLESS": "true",
		"DOTNET_CLI_TELEMETRY_OPTOUT": "1",
		"DOTNET_NOLOGO": "1"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"ms-vscode.PowerShell",
				"GitHub.copilot",
				"GitHub.vscode-github-actions"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "pwsh",
				"editor.trimAutoWhitespace": true,
				"files.trimTrailingWhitespace": true
			}
		}
	},

	// Restore the same way CI does: locked mode against the committed packages.lock.json files.
	"postCreateCommand": "dotnet restore AzDoExtensionNews/AzDoExtensionNews.sln --locked-mode",

	// Non-root user that the Playwright image provides.
	"remoteUser": "pwuser"
}
